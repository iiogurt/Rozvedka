# systemd user unit – triggered by rozvedka-update.timer
[Unit]
Description=Rozvedka – crawl sources and download new reports
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Projects/Rozvedka
ExecStart=%h/Documents/Projects/Rozvedka/.venv/bin/python -m rozvedka update
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
